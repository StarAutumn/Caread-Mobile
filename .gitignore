# 依赖（仅根目录；www/node_modules 内的 Quill/mammoth 为打包资源，需入库）
/node_modules/

# 词典瘦身中间产物（构建脚本输入用；随 APK 打包的是已入库的 www/data/dict-slim.json）
data/dict-slim.json

# Android 构建产物与生成文件（android/ 内已由 Capacitor 自带的 android/.gitignore 覆盖，此处兜底）
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/local.properties
*.apk

# 日志
*.log
npm-debug.log*

# 环境与本地配置
.env
.env.*
*.local

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini
